{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester.local/schemas/mi-facet-v1.schema.json",
  "title": "Jester MI facet artifact",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "base", "module"],
  "properties": {
    "schemaVersion": {"const": "mi-facet-v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"type": "string"},
    "base": {"$ref": "#/$defs/baseBinding"},
    "dependencies": {"$ref": "#/$defs/dependencies"},
    "module": {
      "type": "object",
      "required": ["type", "slots"],
      "properties": {
        "type": {"const": "full-decoder-block"},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/slot"}
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["weights", "format"],
      "properties": {
        "weights": {"type": "string", "minLength": 1},
        "format": {"enum": ["safetensors", "torch"]},
        "sha256": {"type": "string"}
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "facetReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}(@.+)?$"
    },
    "baseBinding": {
      "type": "object",
      "required": ["modelId", "configSha256", "layerPath", "baseLayerCount"],
      "properties": {
        "modelId": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "configSha256": {"type": "string", "minLength": 1},
        "layerPath": {"type": "string", "minLength": 1},
        "baseLayerCount": {"type": "integer", "minimum": 1},
        "modelType": {"type": "string"}
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "requires": {"type": "array", "items": {"$ref": "#/$defs/facetReference"}},
        "after": {"type": "array", "items": {"$ref": "#/$defs/facetReference"}},
        "before": {"type": "array", "items": {"$ref": "#/$defs/facetReference"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/facetReference"}},
        "priority": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["sourceLayer"],
      "properties": {
        "sourceLayer": {"type": "integer", "minimum": 0},
        "initializer": {"enum": ["identity-copy", "copy", "reset", "zero"]},
        "identityTargets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "checkpointPrefix": {"type": "string"}
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["id", "afterLayer", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "afterLayer": {"type": "integer", "minimum": -1},
        "order": {"type": "integer"},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}}
      },
      "additionalProperties": false
    }
  }
}
